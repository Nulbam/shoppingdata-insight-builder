# 환경변수 및 보안 키 (절대 Git에 커밋되지 않도록 차단)
.env

# 가상환경
venv/
.venv/
env/

# Python 캐시 파일
__pycache__/
*.py[cod]
*$py.class

# 업로드 및 테스트 데이터 파일 (폴더 구조 및 샘플 파일 유지)
data/*.csv
data/*.xlsx
!data/kosis_online_shopping_sample.csv

# raw_data 폴더 내 사용자 원본 데이터 보호 (기본 샘플 파일만 허용)
raw_data/*.csv
raw_data/*.xlsx
!raw_data/kosis_sample_raw.csv

# OS 및 에디터 임시 파일
.DS_Store
Thumbs.db
.vscode/
.idea/
